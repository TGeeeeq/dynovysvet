# ── Databáze ──────────────────────────────────────────────────────────────
# Neon, region aws-eu-central-1 (Frankfurt) — kolokace s Vercel fra1.
# POZOR: pro aplikaci používejte POOLED connection string (má v hostname
# „-pooler"). Nepoolovaný patří jen migracím.
DATABASE_URL="postgresql://user:heslo@ep-xxx-pooler.eu-central-1.aws.neon.tech/dynovysvet?sslmode=require"

# ── Vstupenky ─────────────────────────────────────────────────────────────
# Podepisuje QR vstupenky. Musí být stejný na webu i v bráně, jinak brána
# vstupenky neověří. Vygenerujte: openssl rand -base64 48
TICKET_SECRET=""

# ── Platební brána Comgate ────────────────────────────────────────────────
COMGATE_MERCHANT=""
COMGATE_SECRET=""
# V testovacím režimu Comgate neúčtuje skutečné peníze.
COMGATE_TEST="true"

# ── Odesílání e-mailů (Resend) ────────────────────────────────────────────
RESEND_API_KEY=""
# Odesílatel musí být na ověřené doméně, jinak e-maily spadnou do spamu.
MAIL_FROM="Statek u Pipků <vstupenky@dynovysvet.cz>"
# Kam chodí upozornění na nové poptávky.
MAIL_TO="pipkovinovaves@seznam.cz"

# ── Administrace ──────────────────────────────────────────────────────────
# Heslo pro první přihlášení majitele. Po prvním přihlášení se mění v aplikaci.
ADMIN_BOOTSTRAP_EMAIL="pipkovinovaves@seznam.cz"
ADMIN_BOOTSTRAP_PASSWORD=""
